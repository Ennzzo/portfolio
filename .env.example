# Envio do formulário de contato (https://resend.com/api-keys)
RESEND_API_KEY=
# E-mail que recebe as mensagens do formulário
CONTACT_TO_EMAIL=
# Remetente (opcional). Sem domínio verificado no Resend, use o padrão abaixo.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
# Opcional: aumenta o limite da API do GitHub de 60 para 5000 req/h
GITHUB_TOKEN=

# Cards "Fora do código" (opcionais)
# Valorant: chave grátis da HenrikDev API (https://docs.henrikdev.xyz)
HENRIK_API_KEY=
# Strava: app em https://www.strava.com/settings/api + refresh token com escopo activity:read
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
