# Envio do formulário de contato (https://resend.com/api-keys)
RESEND_API_KEY=
# E-mail que recebe as mensagens do formulário
CONTACT_TO_EMAIL=
# Remetente (opcional). Sem domínio verificado no Resend, use o padrão abaixo.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
# Opcional: aumenta o limite da API do GitHub de 60 para 5000 req/h
GITHUB_TOKEN=

# URL pública do site (sitemap, robots e imagens de preview). Na Vercel é detectada sozinha.
NEXT_PUBLIC_SITE_URL=
